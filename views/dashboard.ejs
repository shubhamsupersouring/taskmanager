<%- include('partials/header') %>

  <section class="content content-dashboard">
    <div class="left-col">
      <div>
        <div class="sec-hd">
          <div class="sec-title">
            Team Today
            <span class="sec-sub"><%= (memberCards && memberCards.length) || 0 %> members</span>
          </div>
          <div class="sec-chip">
            <% const activeCount = (memberCards || []).filter(function(m) { return m.todayCount > 0; }).length; %>
            <%= activeCount %> active · <%= ((memberCards && memberCards.length) || 0) - activeCount %> idle
          </div>
          <div class="sec-actions">
            <% if (currentUser && currentUser.role === 'superadmin') { %>
              <form method="post" action="/tasks/sync-sheet" style="display:inline;">
                <button type="submit" class="tb-btn tb-ghost">Sync All</button>
              </form>
            <% } %>
            <a href="/summary/team" class="tb-btn tb-primary">Weekly AI Summary</a>
          </div>
        </div>
        <div class="team-grid">
          <% if (memberCards && memberCards.length) { %>
            <% memberCards.forEach(function(member) { %>
              <div class="mc <%= member.todayCount > 0 ? 'active-mc' : '' %>">
                <div class="mc-top">
                  <div class="mc-info">
                    <div class="mc-av">
                      <%= (member.name || '?').split(' ').map(function(p){ return p[0]; }).join('').slice(0,2).toUpperCase() %>
                    </div>
                    <div>
                      <div class="mc-name"><%= member.name %></div>
                      <div class="mc-tasks <%= member.todayCount > 0 ? 'on' : '' %>"><%= member.todayCount %> task<%= member.todayCount === 1 ? '' : 's' %> today</div>
                    </div>
                  </div>
                  <div class="pill <%= member.todayCount > 0 ? 'pill-on' : 'pill-off' %>"><%= member.todayCount > 0 ? '● Active' : 'Idle' %></div>
                </div>
                <div class="mc-foot">
                  <a href="/members/<%= member.id %>" class="vd-link">View details →</a>
                  <a href="/tasks?member_id=<%= member.id %>&date=<%= new Date().toISOString().slice(0,10) %>" class="add-btn">+ Add Task</a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p class="empty-state">No members found.</p>
          <% } %>
        </div>
      </div>

      <div class="chart-card">
        <div class="sec-hd">
          <div class="sec-title">Today by Member</div>
          <div class="sec-sub">Tasks active</div>
        </div>
        <div class="chart-wrap">
          <canvas id="todayByMemberChart"></canvas>
        </div>
      </div>
    </div>

    <div class="right-col">
      <div class="panel">
        <div class="sec-title">This Week</div>
        <div class="wk-grid">
          <% if (weekDays && weekDays.length) { %>
            <% weekDays.forEach(function(day) { %>
              <div class="wk-day <%= day.isToday ? 'today' : '' %> <%= day.isWeekend ? 'holiday' : '' %>">
                <div class="dn"><%= day.label %></div>
                <div class="dd"><%= day.dateLabel.split(' ')[0] %></div>
                <% if (day.isToday) { %><div class="tdot"></div><% } else if (!day.isWeekend) { %><div class="dm"><%= day.dateLabel.split(' ')[1] || '' %></div><% } else { %><div class="dm">Holiday</div><% } %>
              </div>
            <% }) %>
          <% } else { %>
            <p class="empty-state">No calendar data.</p>
          <% } %>
        </div>
      </div>

      <div>
        <div class="sec-title" style="margin-bottom:9px">Weekly Stats</div>
        <div class="sg">
          <div class="sb s1"><div class="sl">Total Tasks</div><div class="sv"><%= (weeklyStats && weeklyStats.total) || 0 %></div><div class="ss">this week</div></div>
          <div class="sb s2"><div class="sl">In Progress</div><div class="sv"><%= (weeklyStats && weeklyStats.in_progress) || 0 %></div><div class="ss">active now</div></div>
          <div class="sb s3"><div class="sl">Done</div><div class="sv"><%= (weeklyStats && weeklyStats.done) || 0 %></div><div class="ss">completed</div></div>
          <div class="sb s4"><div class="sl">Blocked</div><div class="sv"><%= (weeklyStats && weeklyStats.blocked) || 0 %></div><div class="ss">blockers</div></div>
        </div>
      </div>

      <div class="panel">
        <div class="sec-title">Weekly Status Mix</div>
        <div class="dw">
          <div class="donut-wrap"><canvas id="weeklyStatusChart"></canvas></div>
          <div class="dl">
            <div class="lr"><div class="ldot" style="background:var(--accent)"></div><div class="lname">Done</div><div class="lpct" id="pctDone" style="color:var(--accent)">0%</div></div>
            <div class="lr"><div class="ldot" style="background:var(--accent3)"></div><div class="lname">In Progress</div><div class="lpct" id="pctProgress" style="color:var(--accent3)">0%</div></div>
            <div class="lr"><div class="ldot" style="background:var(--danger)"></div><div class="lname">Blocked</div><div class="lpct" id="pctBlocked" style="color:var(--dim)">0%</div></div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="sec-title">Recent Activity</div>
        <div class="al">
          <div class="ar"><div class="ap" style="background:var(--dim)"></div><div><div class="at">Complete tasks to see activity here.</div><div class="atime">—</div></div></div>
        </div>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    (function () {
      var charts = <%- JSON.stringify(charts || {}) %>;
      var statusCfg = charts.weeklyStatus || { labels: [], data: [] };
      var todayCfg = charts.todayByMember || { labels: [], data: [] };
      var total = (statusCfg.data[0] || 0) + (statusCfg.data[1] || 0) + (statusCfg.data[2] || 0);
      if (total > 0) {
        var pctDone = document.getElementById('pctDone');
        var pctProgress = document.getElementById('pctProgress');
        var pctBlocked = document.getElementById('pctBlocked');
        if (pctDone) pctDone.textContent = Math.round(((statusCfg.data[1] || 0) / total) * 100) + '%';
        if (pctProgress) pctProgress.textContent = Math.round(((statusCfg.data[0] || 0) / total) * 100) + '%';
        if (pctBlocked) pctBlocked.textContent = Math.round(((statusCfg.data[2] || 0) / total) * 100) + '%';
      }
      var weeklyCtx = document.getElementById('weeklyStatusChart');
      if (weeklyCtx && statusCfg.labels.length) {
        new Chart(weeklyCtx, {
          type: 'doughnut',
          data: {
            labels: statusCfg.labels,
            datasets: [{ data: statusCfg.data, backgroundColor: ['#ffb800', '#00d48a', '#ff4d6a'], borderWidth: 0 }]
          },
          options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false } }, cutout: '65%' }
        });
      }
      var todayCtx = document.getElementById('todayByMemberChart');
      if (todayCtx && todayCfg.labels.length) {
        new Chart(todayCtx, {
          type: 'bar',
          data: {
            labels: todayCfg.labels,
            datasets: [{ label: 'Tasks today', data: todayCfg.data, backgroundColor: 'var(--accent)' }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { x: { ticks: { maxRotation: 45, minRotation: 0 } }, y: { beginAtZero: true, precision: 0 } }
          }
        });
      }
    })();
  </script>
  <script src="/script.js"></script>
      </section>
    </div>
  </body>
</html>
