<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | WorkTrack' : 'WorkTrack' %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="login-body">
    <div class="login-wrapper">
      <div class="login-card">
        <h1 class="login-title">Forgot password</h1>
        <p class="login-subtitle">
          Enter your email and we will send you a reset link.
        </p>

        <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
          <div class="flash-container">
            <% (successMessages || []).forEach(function(msg) { %>
              <div class="flash flash-success"><%= msg %></div>
            <% }) %>
            <% (errorMessages || []).forEach(function(msg) { %>
              <div class="flash flash-error"><%= msg %></div>
            <% }) %>
          </div>
        <% } %>

        <form method="post" action="/forgot-password" class="login-form">
          <div class="form-group">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
            />
          </div>

          <button type="submit" class="btn btn-primary login-submit">
            Send reset link
          </button>
        </form>

        <div class="login-hint">
          <p>
            <a href="/login" class="btn-link">Back to login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>

