<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu — Forgot password' %></title>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="auth-body">
    <div class="bg-grid"></div>
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>

    <button class="theme-btn" type="button" data-theme-toggle>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
      <span>Toggle theme</span>
    </button>

    <div id="toastContainer" class="toast-container"></div>
    <div id="globalLoader" class="loader-backdrop" style="display:none;">
      <div class="loader-spinner"></div>
    </div>

    <div class="page">
      <div class="left">
        <div class="brand-row">
          <div class="brand-badge">TB</div>
          <div>
            <div class="brand-name">TrackerBabu</div>
            <div class="brand-tag">Team Work Portal</div>
          </div>
        </div>

        <div class="brand-divider"></div>

        <div class="hero-tagline">Account Recovery</div>

        <h1 class="hero-title">
          Keep your account<br />
          <span>secure and accessible.</span>
        </h1>

        <p class="hero-desc">
          Forgot your password? Enter your email to receive a secure link and get back to tracking daily work and team progress.
        </p>

        <div class="feature-list">
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            Secure, one-time reset links via email
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            No change to your projects, tasks or history
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 0v10l4 4" /></svg>
            </div>
            Works for both admins and members
          </div>
        </div>
      </div>

      <div class="v-divider"></div>

      <div class="right">
        <div class="auth-card">
          <div class="auth-title">Forgot password</div>
          <div class="auth-sub">Enter your email and we’ll send you a reset link.</div>

          <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
            <div class="flash-container">
              <% (successMessages || []).forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
              <% }) %>
              <% (errorMessages || []).forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
              <% }) %>
            </div>
          <% } %>

          <form method="post" action="/forgot-password" class="auth-form">
            <div class="field">
              <label for="email">Email</label>
              <div class="input-wrap">
                <input class="auth-inp has-icon" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
                <svg class="inp-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </div>
            </div>

            <button type="submit" class="signin-btn">Send reset link</button>

            <div class="auth-foot">
              Remember your password? <a href="/login">Back to login</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="/script.js"></script>
  </body>
</html>
