<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="login-body">
    <div id="toastContainer" class="toast-container"></div>
    <div id="globalLoader" class="loader-backdrop" style="display: none;">
      <div class="loader-spinner"></div>
    </div>
    <div class="login-wrapper">
      <div class="login-left">
        <div class="login-badge">
          <span>TrackerBabu</span>
        </div>
        <h1 class="login-headline">Keep your WorkTrack account secure.</h1>
        <p class="login-copy">
          Forgot your password? Enter your email to receive a secure link and
          get back to tracking daily work and team progress.
        </p>
        <ul class="login-bullets">
          <li>Secure, one-time reset links via email.</li>
          <li>No change to your projects, tasks or history.</li>
          <li>Works for both admins and members.</li>
        </ul>
      </div>
      <div class="login-card">
        <div class="login-mobile-hero">
          <div class="login-badge">
            <span>TrackerBabu</span>
          </div>
          <h2 class="login-mobile-headline">Reset access to your TrackerBabu portal.</h2>
        </div>
        <h1 class="login-title">Forgot password</h1>
        <p class="login-subtitle">
          Enter your email and we will send you a reset link.
        </p>

        <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
          <div class="flash-container">
            <% (successMessages || []).forEach(function(msg) { %>
              <div class="flash flash-success"><%= msg %></div>
            <% }) %>
            <% (errorMessages || []).forEach(function(msg) { %>
              <div class="flash flash-error"><%= msg %></div>
            <% }) %>
          </div>
        <% } %>

        <form method="post" action="/forgot-password" class="login-form">
          <div class="form-group">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
            />
          </div>

          <button type="submit" class="btn btn-primary login-submit">
            Send reset link
          </button>
        </form>

        <div class="login-hint">
          <p>
            <a href="/login" class="btn-link">Back to login</a>
          </p>
        </div>
      </div>
    </div>
    <script src="/script.js"></script>
  </body>
</html>

