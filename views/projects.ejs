<%- include('partials/header') %>

  <section class="content content-projects">
    <!-- STATS ROW -->
    <div class="pj-stats-row">
      <div class="pj-stat">
        <div class="pj-stat-ico pj-ico-all">
          <i class="fa-solid fa-folder-tree"></i>
        </div>
        <div class="pj-stat-info">
          <div class="pj-stat-num"><%= typeof totalProjects !== 'undefined' ? totalProjects : (projects && projects.length) || 0 %></div>
          <div class="pj-stat-label">Total Projects</div>
        </div>
      </div>
      <div class="pj-stat">
        <div class="pj-stat-ico pj-ico-active">
          <i class="fa-solid fa-play"></i>
        </div>
        <div class="pj-stat-info">
          <div class="pj-stat-num"><%= typeof activeCount !== 'undefined' ? activeCount : 0 %></div>
          <div class="pj-stat-label">Active</div>
        </div>
      </div>
      <div class="pj-stat">
        <div class="pj-stat-ico pj-ico-completed">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="pj-stat-info">
          <div class="pj-stat-num"><%= typeof completedCount !== 'undefined' ? completedCount : 0 %></div>
          <div class="pj-stat-label">Completed</div>
        </div>
      </div>
      <div class="pj-stat">
        <div class="pj-stat-ico pj-ico-pending">
          <i class="fa-solid fa-pause"></i>
        </div>
        <div class="pj-stat-info">
          <div class="pj-stat-num"><%= typeof pendingCount !== 'undefined' ? pendingCount : 0 %></div>
          <div class="pj-stat-label">Planning / On hold</div>
        </div>
      </div>
    </div>

    <!-- FILTER BAR -->
    <form method="get" action="/projects" class="toolbar projects-toolbar">
      <div class="search-wrap">
        <input
          class="search-inp"
          type="text"
          name="q"
          id="projectSearch"
          value="<%= searchQuery || '' %>"
          placeholder="Search projects…"
        />
      </div>

      <input type="hidden" name="status" id="projectStatusInput" value="<%= activeStatus || '' %>">

      <div class="role-filter" id="projectStatusFilters">
        <button type="button" class="rf-pill <%= !activeStatus ? 'active' : '' %>" data-status="">All</button>
        <button type="button" class="rf-pill <%= activeStatus === 'active' ? 'active' : '' %>" data-status="active">Active</button>
        <button type="button" class="rf-pill <%= activeStatus === 'completed' ? 'active' : '' %>" data-status="completed">Completed</button>
        <button type="button" class="rf-pill <%= activeStatus === 'planning' ? 'active' : '' %>" data-status="planning">Planning</button>
        <button type="button" class="rf-pill <%= activeStatus === 'on-hold' ? 'active' : '' %>" data-status="on-hold">On Hold</button>
      </div>

      <button type="button" class="btn btn-g ml-auto" id="openProjectModal">
        <i class="fa-solid fa-plus"></i> Add Project
      </button>
    </form>

    <!-- PROJECT GRID -->
    <div class="project-grid" id="projectGrid">
      <% if (projects && projects.length) { %>
        <% projects.forEach(function(project) { %>
          <div
            class="pj-card"
            data-project-id="<%= project.id %>"
            data-project-name="<%= project.name %>"
            data-project-description="<%= project.description || '' %>"
            data-project-status="<%= (project.status || 'active').toLowerCase() %>"
          >
            <div class="pj-card-top">
              <div class="pj-logo">
                <%= (project.name || '?').split(' ').map(function(p){ return p[0]; }).join('').slice(0,2).toUpperCase() %>
              </div>
              <div class="pj-top-right">
                <span class="pj-date">
                  <% if (project.created_at) { %>
                    <%= new Date(project.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  <% } %>
                </span>
              </div>
            </div>

            <div class="pj-title"><%= project.name %></div>
            <div class="pj-desc"><%= project.description || 'No description added yet.' %></div>

            <div class="pj-card-footer">
              <button
                type="button"
                class="mact-btn pj-edit edit-project"
                data-project-id="<%= project.id %>"
              >
                <i class="fa-regular fa-pen-to-square" style="font-size:11px;"></i>
                Edit
              </button>
              <form
                method="post"
                action="/projects/<%= project.id %>/delete"
                class="project-delete-form"
                style="display:inline;"
              >
                <button type="button" class="mact-btn pj-del project-delete-btn">
                  <i class="fa-regular fa-trash-can" style="font-size:11px;"></i>
                  Delete
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty" style="grid-column:1 / -1;">
          <div class="ei"><i class="fa-regular fa-folder-open" style="font-size:18px;"></i></div>
          <div class="et">No projects defined yet.</div>
          <div class="es">Use “Add Project” to create your first project.</div>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Add / Edit project modal (logic reused, UI compact) -->
  <div class="modal ts-modal" id="projectModal">
    <div class="modal-backdrop" data-close-project></div>
    <div class="modal-content">
      <div class="modal-header ts-modal-header">
        <h3 id="projectModalTitle" class="ts-modal-title">Add project</h3>
      </div>
      <div class="modal-body ts-modal-body">
        <form method="post" action="/projects/add" id="projectForm">
          <input type="hidden" name="id" id="projectId" />

          <div class="th-row">
            <div class="th-field">
              <label for="projectName">Project name</label>
              <input id="projectName" name="name" type="text" class="inp" required />
            </div>
          </div>

          <div class="th-row">
            <div class="th-field">
              <label for="projectDescription">Description (optional)</label>
              <input id="projectDescription" name="description" type="text" class="inp" />
            </div>
          </div>

          <div class="th-row">
            <div class="th-field">
              <label for="projectStatus">Status</label>
              <select id="projectStatus" name="status" class="sel">
                <option value="active">Active</option>
                <option value="completed">Completed</option>
                <option value="planning">Planning</option>
                <option value="on-hold">On Hold</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer ts-modal-footer">
        <button type="button" class="btn btn-g" data-close-project>Cancel</button>
        <button type="submit" form="projectForm" class="btn btn-p" id="projectSubmitBtn">
          Save project
        </button>
      </div>
    </div>
  </div>

  <!-- Shared delete confirmation modal -->
  <div class="modal" id="confirmDeleteModal">
    <div class="modal-backdrop" id="confirmDeleteCancel"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>Confirm delete</h3>
      </div>
      <div class="modal-body">
        <p id="confirmDeleteText">
          Are you sure you want to delete this item?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="confirmDeleteCancelBtn">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="confirmDeleteConfirmBtn">
          Delete
        </button>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var toolbarForm = document.querySelector('.projects-toolbar');
      var statusInput = document.getElementById('projectStatusInput');
      var statusFilters = document.getElementById('projectStatusFilters');
      var openModalBtn = document.getElementById('openProjectModal');
      var projectModal = document.getElementById('projectModal');
      var modalTitle = document.getElementById('projectModalTitle');
      var form = document.getElementById('projectForm');
      var idInput = document.getElementById('projectId');
      var nameInput = document.getElementById('projectName');
      var descInput = document.getElementById('projectDescription');
      var statusSelect = document.getElementById('projectStatus');
      var submitBtn = document.getElementById('projectSubmitBtn');

      if (statusFilters && statusInput && toolbarForm) {
        statusFilters.querySelectorAll('.rf-pill').forEach(function (pill) {
          pill.addEventListener('click', function () {
            var v = pill.getAttribute('data-status') || '';
            statusInput.value = v;
            toolbarForm.submit();
          });
        });
      }

      function openModal(mode, project) {
        if (!projectModal) return;
        if (mode === 'edit') {
          modalTitle.textContent = 'Edit project';
          submitBtn.textContent = 'Update project';
          if (project) {
            idInput.value = project.id || '';
            nameInput.value = project.name || '';
            descInput.value = project.description || '';
            if (statusSelect) statusSelect.value = project.status || 'active';
          }
        } else {
          modalTitle.textContent = 'Add project';
          submitBtn.textContent = 'Save project';
          idInput.value = '';
          nameInput.value = '';
          descInput.value = '';
          if (statusSelect) statusSelect.value = 'active';
        }
        projectModal.classList.add('open');
        if (nameInput) nameInput.focus();
      }

      function closeModal() {
        if (!projectModal) return;
        projectModal.classList.remove('open');
      }

      if (openModalBtn) {
        openModalBtn.addEventListener('click', function () {
          openModal('add');
        });
      }

      document.querySelectorAll('[data-close-project]').forEach(function (el) {
        el.addEventListener('click', closeModal);
      });

      document.addEventListener('click', function (e) {
        if (e.target.classList.contains('modal-backdrop') && e.target.closest('#projectModal')) {
          closeModal();
        }
      });

      document.querySelectorAll('.edit-project').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.pj-card');
          if (!card) return;
          openModal('edit', {
            id: card.getAttribute('data-project-id'),
            name: card.getAttribute('data-project-name') || '',
            description: card.getAttribute('data-project-description') || '',
            status: card.getAttribute('data-project-status') || 'active'
          });
        });
      });

      // Themed delete modal for projects
      document.querySelectorAll('.project-delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var formEl = btn.closest('form');
          if (!formEl) return;
          if (typeof openConfirm === 'function') {
            openConfirm('Delete this project?', function () {
              formEl.submit();
            });
          } else if (window.confirm('Delete this project?')) {
            formEl.submit();
          }
        });
      });
    })();
  </script>
  <script>
    // Extra safety: ensure theme toggle + burger work on Projects page
    (function () {
      var root = document.documentElement;
      var THEME_KEY = 'worktrack_theme';

      function applyThemeLocal(theme) {
        var mode = theme === 'dark' ? 'dark' : 'light';
        root.setAttribute('data-theme', mode);
        try {
          localStorage.setItem(THEME_KEY, mode);
        } catch (e) {}

        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          var icon = btn.querySelector('svg');
          var label = btn.querySelector('span');
          if (!icon || !label) return;
          if (mode === 'light') {
            icon.innerHTML =
              '<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>';
            label.textContent = 'Dark mode';
          } else {
            icon.innerHTML =
              '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
            label.textContent = 'Light mode';
          }
        });
      }

      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var current =
            root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          applyThemeLocal(next);
        });
      });

      var sidebarToggle = document.getElementById('sidebarToggle');
      var sidebar = document.querySelector('.sidebar');
      if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          sidebar.classList.toggle('open');
        });
      }
    })();
  </script>
  <script>
    window.projectsPagination = <%- JSON.stringify(pagination || null) %>;
  </script>

  <script src="/script.js"></script>

  <script>
    (function () {
      var form = document.getElementById('projectForm');
      var idInput = document.getElementById('projectId');
      var nameInput = document.getElementById('projectName');
      var descInput = document.getElementById('projectDescription');
      var submitBtn = document.getElementById('projectSubmitBtn');
      var resetBtn = document.getElementById('projectResetBtn');

      function resetForm() {
        if (idInput) idInput.value = '';
        if (nameInput) nameInput.value = '';
        if (descInput) descInput.value = '';
        if (submitBtn) submitBtn.textContent = 'Add project';
        if (resetBtn) resetBtn.style.display = 'none';
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          resetForm();
        });
      }

      document.querySelectorAll('.edit-project').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.project-card');
          if (!card) return;
          var id = card.getAttribute('data-project-id');
          var name = card.getAttribute('data-project-name') || '';
          var description = card.getAttribute('data-project-description') || '';

          if (idInput) idInput.value = id || '';
          if (nameInput) nameInput.value = name;
          if (descInput) descInput.value = description;
          if (submitBtn) submitBtn.textContent = 'Update project';
          if (resetBtn) resetBtn.style.display = 'inline-flex';

          if (nameInput) nameInput.focus();
        });
      });

      // Themed delete modal for projects
      document.querySelectorAll('.project-delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var formEl = btn.closest('form');
          if (!formEl) return;
          if (typeof openConfirm === 'function') {
            openConfirm('Delete this project?', function () {
              formEl.submit();
            });
          } else if (window.confirm('Delete this project?')) {
            formEl.submit();
          }
        });
      });
    })();
  </script>

  <!-- Shared delete confirmation modal -->
  <div class="modal" id="confirmDeleteModal">
    <div class="modal-backdrop" id="confirmDeleteCancel"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>Confirm delete</h3>
      </div>
      <div class="modal-body">
        <p id="confirmDeleteText">
          Are you sure you want to delete this item?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="confirmDeleteCancelBtn">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="confirmDeleteConfirmBtn">
          Delete
        </button>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
      </section>
    </div>
  </body>
</html>

