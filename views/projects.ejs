<%- include('partials/header') %>

  <section class="tasks-layout">
    <div class="card">
      <div class="card-header">
        <h2>Projects</h2>
      </div>

      <div class="card-body">
        <form method="post" action="/projects/add" class="filters-form" id="projectForm">
          <input type="hidden" name="id" id="projectId" />

          <div class="form-group">
            <label for="projectName">Project name</label>
            <input id="projectName" name="name" type="text" required />
          </div>

          <div class="form-group" style="flex: 1;">
            <label for="projectDescription">Description (optional)</label>
            <input id="projectDescription" name="description" type="text" />
          </div>

          <div class="filters-actions">
            <button type="submit" class="btn btn-primary" id="projectSubmitBtn">
              Add project
            </button>
            <button type="button" class="btn btn-outline btn-sm" id="projectResetBtn" style="display:none;">
              Cancel edit
            </button>
          </div>
        </form>
      </div>

      <div class="scroll-card-grid" style="margin-top: 1rem;">
        <% if (projects && projects.length) { %>
          <% projects.forEach(function(project) { %>
            <div
              class="project-card"
              data-project-id="<%= project.id %>"
              data-project-name="<%= project.name %>"
              data-project-description="<%= project.description || '' %>"
            >
              <div class="project-card-header">
                <div class="project-card-title"><%= project.name %></div>
                <span class="text-muted" style="font-size: 0.75rem;">
                  <%= new Date(project.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </span>
              </div>
              <div class="project-card-meta">
                <%= project.description || 'No description provided.' %>
              </div>
              <div class="project-card-footer">
                <button
                  type="button"
                  class="btn btn-outline btn-sm edit-project"
                  data-project-id="<%= project.id %>"
                >
                  Edit
                </button>
                <form
                  method="post"
                  action="/projects/<%= project.id %>/delete"
                  class="project-delete-form"
                  style="display:inline;"
                >
                  <button type="button" class="btn btn-outline btn-sm text-danger project-delete-btn">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty-state">No projects defined yet.</p>
        <% } %>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var form = document.getElementById('projectForm');
      var idInput = document.getElementById('projectId');
      var nameInput = document.getElementById('projectName');
      var descInput = document.getElementById('projectDescription');
      var submitBtn = document.getElementById('projectSubmitBtn');
      var resetBtn = document.getElementById('projectResetBtn');

      function resetForm() {
        if (idInput) idInput.value = '';
        if (nameInput) nameInput.value = '';
        if (descInput) descInput.value = '';
        if (submitBtn) submitBtn.textContent = 'Add project';
        if (resetBtn) resetBtn.style.display = 'none';
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          resetForm();
        });
      }

      document.querySelectorAll('.edit-project').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.project-card');
          if (!card) return;
          var id = card.getAttribute('data-project-id');
          var name = card.getAttribute('data-project-name') || '';
          var description = card.getAttribute('data-project-description') || '';

          if (idInput) idInput.value = id || '';
          if (nameInput) nameInput.value = name;
          if (descInput) descInput.value = description;
          if (submitBtn) submitBtn.textContent = 'Update project';
          if (resetBtn) resetBtn.style.display = 'inline-flex';

          if (nameInput) nameInput.focus();
        });
      });

      // Themed delete modal for projects
      document.querySelectorAll('.project-delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var formEl = btn.closest('form');
          if (!formEl) return;
          if (typeof openConfirm === 'function') {
            openConfirm('Delete this project?', function () {
              formEl.submit();
            });
          } else if (window.confirm('Delete this project?')) {
            formEl.submit();
          }
        });
      });
    })();
  </script>

  <!-- Shared delete confirmation modal -->
  <div class="modal" id="confirmDeleteModal">
    <div class="modal-backdrop" id="confirmDeleteCancel"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>Confirm delete</h3>
      </div>
      <div class="modal-body">
        <p id="confirmDeleteText">
          Are you sure you want to delete this item?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="confirmDeleteCancelBtn">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="confirmDeleteConfirmBtn">
          Delete
        </button>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
      </section>
    </div>
  </body>
</html>

