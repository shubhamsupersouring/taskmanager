<%- include('partials/header') %>

  <section class="content content-members">
    <!-- STATS -->
    <div class="m-stats">
      <div class="ms-card">
        <div class="ms-icon ms-total">
          <i class="fa-regular fa-user"></i>
        </div>
        <div>
          <div class="ms-val">
            <%= typeof totalMembers !== 'undefined' ? totalMembers : (members && members.length) || 0 %>
          </div>
          <div class="ms-lbl">Total Members</div>
        </div>
      </div>
      <div class="ms-card">
        <div class="ms-icon ms-roles">
          <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
          <div class="ms-val"><%= (roles && roles.length) || 0 %></div>
          <div class="ms-lbl">Unique Roles</div>
        </div>
      </div>
      <div class="ms-card">
        <div class="ms-icon ms-active">
          <i class="fa-regular fa-clock"></i>
        </div>
        <div>
          <div class="ms-val"><%= latestJoinedLabel || '' %></div>
          <div class="ms-lbl">Latest Joined</div>
        </div>
      </div>
    </div>

    <!-- SEARCH + VIEW TOGGLE -->
    <form method="get" action="/members" class="toolbar members-toolbar">
      <div class="search-wrap">
        <input
          class="search-inp"
          type="text"
          name="q"
          id="memberSearch"
          value="<%= searchQuery || '' %>"
          placeholder="Search members…"
        />
      </div>

      <input type="hidden" name="role" id="roleInput" value="<%= activeRole || '' %>">

      <div class="role-filter" id="roleFilters">
        <button type="button" class="rf-pill <%= !activeRole ? 'active' : '' %>" data-role="">All</button>
        <% (roles || []).forEach(function(role) { %>
          <button type="button" class="rf-pill <%= activeRole === role ? 'active' : '' %>" data-role="<%= role %>"><%= role %></button>
        <% }) %>
      </div>

      <div class="ml-auto view-toggle">
        <button type="button" class="vt-btn active" id="viewGrid" title="Grid view">
          <i class="fa-solid fa-border-all"></i>
        </button>
        <button type="button" class="vt-btn" id="viewList" title="List view">
          <i class="fa-solid fa-list"></i>
        </button>
      </div>

      <button type="button" class="btn btn-p" id="openMemberModal">
        <i class="fa-solid fa-plus"></i> Add Member
      </button>
    </form>

    <!-- MEMBER GRID -->
    <div class="member-grid" id="memberGrid">
      <% if (members && members.length) { %>
        <% members.forEach(function(member) { %>
          <div
            class="mcard"
            data-member-id="<%= member.id %>"
            data-member-name="<%= member.name %>"
            data-member-role="<%= member.role %>"
            data-member-email="<%= member.user_email || '' %>"
          >
            <div class="mcard-inner">
              <div class="mav-wrap">
                <div class="mav">
                  <%= (member.name || '?').split(' ').map(function(p){ return p[0]; }).join('').slice(0,2).toUpperCase() %>
                </div>
                <div class="mav-status"></div>
              </div>

              <div class="mcard-info">
                <div class="mcard-top">
                  <div class="mcard-name"><%= member.name %></div>
                  <div class="mcard-date">
                    <% if (member.created_at) { %>
                      <%= new Date(member.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    <% } %>
                  </div>
                </div>
                <div class="mcard-role">
                  <i class="fa-solid fa-briefcase" style="font-size:10px;"></i>
                  <%= member.role %>
                </div>
                <div class="mcard-email">
                  <i class="fa-regular fa-envelope" style="font-size:11px;"></i>
                  <span><%= member.user_email || 'Not linked' %></span>
                </div>
              </div>

              <div class="mcard-right">
                <button type="button" class="mact-btn mact-view" onclick="window.location.href='/members/<%= member.id %>'">
                  <i class="fa-regular fa-eye" style="font-size:11px;"></i>
                  View
                </button>
                <button
                  type="button"
                  class="mact-btn mact-edit edit-member"
                  data-member-id="<%= member.id %>"
                >
                  <i class="fa-regular fa-pen-to-square" style="font-size:11px;"></i>
                  Edit
                </button>
                <form
                  method="post"
                  action="/members/<%= member.id %>/delete"
                  class="member-delete-form"
                  style="display:inline;"
                >
                  <button type="button" class="mact-btn mact-del member-delete-btn">
                    <i class="fa-regular fa-trash-can" style="font-size:11px;"></i>
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty" style="grid-column:1 / -1;">
          <div class="ei"><i class="fa-regular fa-user" style="font-size:18px;"></i></div>
          <div class="et">No members defined yet.</div>
          <div class="es">Use “Add Member” to create your first team member.</div>
        </div>
      <% } %>
    </div>

  <div class="modal" id="memberModal">
    <div class="modal-backdrop" id="closeMemberModal"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="memberModalTitle">Add member</h3>
        <button class="modal-close" id="memberModalCloseBtn">&times;</button>
      </div>
      <form method="post" action="/members/add" class="modal-body" id="memberForm">
        <input type="hidden" name="id" id="memberId" />

        <div class="form-group">
          <label for="memberName">Name</label>
          <input id="memberName" name="name" type="text" required />
        </div>

        <div class="form-group">
          <label for="memberRole">Role</label>
          <input id="memberRole" name="role" type="text" placeholder="e.g. Developer, Manager" required />
        </div>

        <div class="form-group">
          <label for="memberEmail">Login email</label>
          <input id="memberEmail" name="email" type="email" placeholder="user@example.com" required />
          <span class="text-muted" style="font-size: 0.75rem;">
            Used to send TrackerBabu login credentials when creating a new member.
          </span>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="cancelMemberModal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary" id="memberSubmitBtn">
            Save member
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // View + role filters for members grid (server-side search)
    (function () {
      var grid = document.getElementById('memberGrid');
      var search = document.getElementById('memberSearch');
      var roleContainer = document.getElementById('roleFilters');
      var roleInput = document.getElementById('roleInput');
      var toolbarForm = document.querySelector('.members-toolbar');

      if (grid && search && toolbarForm) {
        // Submit on Enter for search
        search.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            toolbarForm.submit();
          }
        });

        // Role pills set role hidden field and submit
        if (roleContainer && roleInput) {
          roleContainer.querySelectorAll('.rf-pill').forEach(function (btn) {
            btn.addEventListener('click', function () {
              roleContainer
                .querySelectorAll('.rf-pill')
                .forEach(function (b) {
                  b.classList.remove('active');
                });
              btn.classList.add('active');
              roleInput.value = btn.getAttribute('data-role') || '';
              toolbarForm.submit();
            });
          });
        }

        var gridBtn = document.getElementById('viewGrid');
        var listBtn = document.getElementById('viewList');
        if (gridBtn && listBtn) {
          gridBtn.addEventListener('click', function () {
            grid.classList.remove('list-view');
            gridBtn.classList.add('active');
            listBtn.classList.remove('active');
          });
          listBtn.addEventListener('click', function () {
            grid.classList.add('list-view');
            listBtn.classList.add('active');
            gridBtn.classList.remove('active');
          });
        }
      }

      // Existing modal + delete logic
      var modal = document.getElementById('memberModal');
      var openBtn = document.getElementById('openMemberModal');
      var closeBackdrop = document.getElementById('closeMemberModal');
      var closeBtn = document.getElementById('memberModalCloseBtn');
      var cancelBtn = document.getElementById('cancelMemberModal');
      var memberId = document.getElementById('memberId');
      var memberName = document.getElementById('memberName');
      var memberRole = document.getElementById('memberRole');
      var memberEmail = document.getElementById('memberEmail');
      var modalTitle = document.getElementById('memberModalTitle');
      var submitBtn = document.getElementById('memberSubmitBtn');

      function openModal(member) {
        if (!modal) return;

        if (member) {
          if (modalTitle) modalTitle.textContent = 'Edit member';
          if (submitBtn) submitBtn.textContent = 'Update member';
          if (memberId) memberId.value = member.id || '';
          if (memberName) memberName.value = member.name || '';
          if (memberRole) memberRole.value = member.role || '';
          if (memberEmail) {
            memberEmail.value = member.email || '';
            memberEmail.disabled = true;
          }
        } else {
          if (modalTitle) modalTitle.textContent = 'Add member';
          if (submitBtn) submitBtn.textContent = 'Save member';
          if (memberId) memberId.value = '';
          if (memberName) memberName.value = '';
          if (memberRole) memberRole.value = '';
          if (memberEmail) {
            memberEmail.value = '';
            memberEmail.disabled = false;
          }
        }

        modal.classList.add('open');
        if (memberName) memberName.focus();
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('open');
      }

      if (openBtn) {
        openBtn.addEventListener('click', function () {
          openModal(null);
        });
      }
      if (closeBackdrop) closeBackdrop.addEventListener('click', closeModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

      document.querySelectorAll('.edit-member').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.mcard');
          if (!card) return;
          var id = card.getAttribute('data-member-id');
          var name = card.getAttribute('data-member-name') || '';
          var role = card.getAttribute('data-member-role') || '';
          var email = card.getAttribute('data-member-email') || '';
          openModal({ id: id, name: name, role: role, email: email });
        });
      });

      // Themed delete modal for members
      document.querySelectorAll('.member-delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var formEl = btn.closest('form');
          if (!formEl) return;
          if (typeof openConfirm === 'function') {
            openConfirm(
              'Delete this member? All their tasks will also be removed.',
              function () {
                formEl.submit();
              }
            );
          } else if (
            window.confirm('Delete this member? All their tasks will also be removed.')
          ) {
            formEl.submit();
          }
        });
      });
    })();
  </script>

  <!-- Shared delete confirmation modal -->
  <div class="modal" id="confirmDeleteModal">
    <div class="modal-backdrop" id="confirmDeleteCancel"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>Confirm delete</h3>
      </div>
      <div class="modal-body">
        <p id="confirmDeleteText">
          Are you sure you want to delete this item?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="confirmDeleteCancelBtn">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="confirmDeleteConfirmBtn">
          Delete
        </button>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
