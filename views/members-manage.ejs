<%- include('partials/header') %>

  <section class="tasks-layout">
    <div class="card">
      <div class="card-header">
        <h2>Members</h2>
        <button type="button" class="btn btn-primary btn-sm" id="openMemberModal">
          Add member
        </button>
      </div>

      <div class="scroll-card-grid" style="margin-top: 0.75rem;">
        <% if (members && members.length) { %>
          <% members.forEach(function(member) { %>
            <div
              class="member-manage-card"
              data-member-id="<%= member.id %>"
              data-member-name="<%= member.name %>"
              data-member-role="<%= member.role %>"
            >
              <div class="member-manage-card-header">
                <div class="member-manage-card-title"><%= member.name %></div>
                <span class="text-muted" style="font-size: 0.75rem;">
                  <%= new Date(member.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </span>
              </div>
              <div class="member-manage-card-meta">
                <strong>Role:</strong> <%= member.role %>
              </div>
              <div class="member-manage-card-meta">
                <strong>Email:</strong> <%= member.user_email || 'Not linked' %>
              </div>
              <div class="member-manage-card-footer">
                <button
                  type="button"
                  class="btn btn-outline btn-sm edit-member"
                  data-member-id="<%= member.id %>"
                >
                  Edit
                </button>
                <form
                  method="post"
                  action="/members/<%= member.id %>/delete"
                  class="member-delete-form"
                  style="display:inline;"
                >
                  <button type="button" class="btn btn-outline btn-sm text-danger member-delete-btn">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty-state">No members defined yet.</p>
        <% } %>
      </div>
    </div>
  </section>

  <div class="modal" id="memberModal">
    <div class="modal-backdrop" id="closeMemberModal"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="memberModalTitle">Add member</h3>
        <button class="modal-close" id="memberModalCloseBtn">&times;</button>
      </div>
      <form method="post" action="/members/add" class="modal-body" id="memberForm">
        <input type="hidden" name="id" id="memberId" />

        <div class="form-group">
          <label for="memberName">Name</label>
          <input id="memberName" name="name" type="text" required />
        </div>

        <div class="form-group">
          <label for="memberRole">Role</label>
          <input id="memberRole" name="role" type="text" placeholder="e.g. Developer, Manager" />
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="cancelMemberModal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary" id="memberSubmitBtn">
            Save member
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function () {
      var modal = document.getElementById('memberModal');
      var openBtn = document.getElementById('openMemberModal');
      var closeBackdrop = document.getElementById('closeMemberModal');
      var closeBtn = document.getElementById('memberModalCloseBtn');
      var cancelBtn = document.getElementById('cancelMemberModal');
      var memberId = document.getElementById('memberId');
      var memberName = document.getElementById('memberName');
      var memberRole = document.getElementById('memberRole');
      var modalTitle = document.getElementById('memberModalTitle');
      var submitBtn = document.getElementById('memberSubmitBtn');

      function openModal(member) {
        if (!modal) return;

        if (member) {
          if (modalTitle) modalTitle.textContent = 'Edit member';
          if (submitBtn) submitBtn.textContent = 'Update member';
          if (memberId) memberId.value = member.id || '';
          if (memberName) memberName.value = member.name || '';
          if (memberRole) memberRole.value = member.role || '';
        } else {
          if (modalTitle) modalTitle.textContent = 'Add member';
          if (submitBtn) submitBtn.textContent = 'Save member';
          if (memberId) memberId.value = '';
          if (memberName) memberName.value = '';
          if (memberRole) memberRole.value = '';
        }

        modal.classList.add('open');
        if (memberName) memberName.focus();
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('open');
      }

      if (openBtn) {
        openBtn.addEventListener('click', function () {
          openModal(null);
        });
      }
      if (closeBackdrop) closeBackdrop.addEventListener('click', closeModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

      document.querySelectorAll('.edit-member').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.member-manage-card');
          if (!card) return;
          var id = card.getAttribute('data-member-id');
          var name = card.getAttribute('data-member-name') || '';
          var role = card.getAttribute('data-member-role') || '';
          openModal({ id: id, name: name, role: role });
        });
      });

      // Themed delete modal for members
      document.querySelectorAll('.member-delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var formEl = btn.closest('form');
          if (!formEl) return;
          if (typeof openConfirm === 'function') {
            openConfirm(
              'Delete this member? All their tasks will also be removed.',
              function () {
                formEl.submit();
              }
            );
          } else if (
            window.confirm('Delete this member? All their tasks will also be removed.')
          ) {
            formEl.submit();
          }
        });
      });
    })();
  </script>

  <!-- Shared delete confirmation modal -->
  <div class="modal" id="confirmDeleteModal">
    <div class="modal-backdrop" id="confirmDeleteCancel"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3>Confirm delete</h3>
      </div>
      <div class="modal-body">
        <p id="confirmDeleteText">
          Are you sure you want to delete this item?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="confirmDeleteCancelBtn">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="confirmDeleteConfirmBtn">
          Delete
        </button>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
