<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu — Sign in' %></title>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
    <style>
      *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
      html,body{height:100%;overflow:hidden;}
      body.auth-body{
        font-family:'DM Sans',sans-serif;
        background:var(--bg);
        color:var(--txt);
        display:flex;
        align-items:stretch;
        min-height:100vh;
        transition:background var(--tr),color var(--tr);
      }
      .bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
      .bg-grid::before{content:'';position:absolute;inset:0;
        background-image:
          linear-gradient(rgba(0,212,138,.035) 1px,transparent 1px),
          linear-gradient(90deg,rgba(0,212,138,.035) 1px,transparent 1px);
        background-size:48px 48px;opacity:.35;}
      [data-theme="light"] .bg-grid::before{opacity:.5;}
      .orb{position:fixed;border-radius:50%;pointer-events:none;z-index:0;filter:blur(100px);}
      .o1{width:500px;height:500px;top:-150px;left:-100px;background:radial-gradient(circle,rgba(0,212,138,.12) 0%,transparent 70%);}
      .o2{width:400px;height:400px;bottom:-100px;right:-80px;background:radial-gradient(circle,rgba(61,127,255,.1) 0%,transparent 70%);}
      .o3{width:300px;height:300px;top:40%;left:30%;background:radial-gradient(circle,rgba(0,212,138,.05) 0%,transparent 70%);}

      .theme-btn{
        position:fixed;top:18px;right:18px;z-index:50;
        background:var(--surf);border:1px solid var(--bdr);
        border-radius:10px;padding:7px 10px;cursor:pointer;
        display:flex;align-items:center;gap:6px;
        font-size:11.5px;font-weight:500;color:var(--dim2);
        transition:background var(--tr),border-color .15s,color .15s;
        font-family:'DM Sans',sans-serif;
      }
      .theme-btn:hover{border-color:var(--accent);color:var(--accent);}

      .page{position:relative;z-index:1;width:100%;display:flex;align-items:center;min-height:100vh;}
      .left{flex:1;display:flex;flex-direction:column;justify-content:center;
        padding:60px 64px;max-width:620px;position:relative;}
      .brand-row{display:flex;align-items:center;gap:11px;margin-bottom:56px;}
      .brand-badge{
        width:40px;height:40px;
        background:linear-gradient(135deg,var(--accent),#009e68);
        border-radius:12px;display:flex;align-items:center;justify-content:center;
        font-family:'Syne',sans-serif;font-weight:800;font-size:14px;color:var(--ink);
        box-shadow:var(--glow);flex-shrink:0;
      }
      .brand-name{font-family:'Syne',sans-serif;font-weight:800;font-size:15px;color:var(--txt);letter-spacing:-.2px;}
      .brand-tag{
        display:inline-flex;align-items:center;gap:5px;
        font-size:9px;letter-spacing:2px;text-transform:uppercase;font-weight:600;
        color:var(--accent);margin-top:2px;
      }
      .brand-tag::before{content:'';width:16px;height:1.5px;background:var(--accent);border-radius:2px;}
      .brand-divider{width:1px;height:48px;
        background:linear-gradient(to bottom,var(--accent),transparent);
        margin:0 0 28px 19px;}
      .hero-tagline{
        font-size:9px;letter-spacing:3.5px;text-transform:uppercase;
        color:var(--accent);font-weight:600;margin-bottom:18px;}
      .hero-title{
        font-family:'Syne',sans-serif;
        font-size:clamp(32px,4vw,52px);
        font-weight:800;line-height:1.1;letter-spacing:-1.5px;
        color:var(--txt);margin-bottom:22px;}
      .hero-title span{
        background:linear-gradient(135deg,var(--accent),#00ff9f);
        -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
      .hero-desc{
        font-size:14.5px;color:var(--dim2);line-height:1.7;
        max-width:420px;margin-bottom:36px;}
      .feature-list{display:flex;flex-direction:column;gap:10px;}
      .feat{display:flex;align-items:center;gap:11px;font-size:13px;color:var(--dim2);}
      .feat-dot{
        width:22px;height:22px;border-radius:7px;flex-shrink:0;
        background:rgba(0,212,138,.12);border:1px solid rgba(0,212,138,.2);
        display:flex;align-items:center;justify-content:center;
        color:var(--accent);}

      .v-divider{width:1px;background:var(--bdr);flex-shrink:0;align-self:stretch;margin:40px 0;}
      .right{flex:0 0 480px;display:flex;align-items:center;justify-content:center;padding:40px 48px;}
      .auth-card{
        width:100%;max-width:420px;
        background:var(--card-bg, var(--surf));
        border:1px solid var(--bdr);
        border-radius:22px;
        padding:36px 32px;
        backdrop-filter:blur(24px);
        box-shadow:var(--shd),0 0 0 1px rgba(0,212,138,.04);
        position:relative;overflow:hidden;
      }
      .auth-title{
        font-family:'Syne',sans-serif;
        font-size:26px;font-weight:800;letter-spacing:-.6px;
        color:var(--txt);margin-bottom:6px;}
      .auth-sub{font-size:13px;color:var(--dim2);margin-bottom:24px;}

      .auth-form{display:flex;flex-direction:column;gap:18px;}
      .field{display:flex;flex-direction:column;gap:7px;}
      .field label{
        font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;
        color:var(--dim2);}
      .input-wrap{position:relative;}
      .auth-inp{
        width:100%;background:var(--surf2);
        border:1.5px solid var(--bdr);
        color:var(--txt);border-radius:11px;
        padding:12px 16px;font-size:13.5px;
        outline:none;font-family:'DM Sans',sans-serif;
        transition:border-color .2s,background var(--tr),color var(--tr),box-shadow .2s;}
      .auth-inp::placeholder{color:var(--dim);}
      .auth-inp:focus{
        border-color:var(--accent);
        box-shadow:0 0 0 3px rgba(0,212,138,.12);}
      .auth-inp.has-icon{padding-left:42px;}
      .inp-icon{
        position:absolute;left:14px;top:50%;transform:translateY(-50%);
        color:var(--dim);pointer-events:none;transition:color .2s;}
      .auth-inp:focus ~ .inp-icon,.input-wrap:focus-within .inp-icon{color:var(--accent);}

      .forgot-link{
        text-align:right;margin-top:-6px;
        font-size:12px;color:var(--dim2);}
      .forgot-link a{color:var(--accent);text-decoration:none;}
      .forgot-link a:hover{text-decoration:underline;}

      .signin-btn{
        width:100%;padding:13px;border-radius:12px;border:none;cursor:pointer;
        background:linear-gradient(135deg,var(--accent) 0%,#00b876 100%);
        color:var(--ink);font-size:14px;font-weight:700;
        font-family:'Syne',sans-serif;letter-spacing:.3px;
        box-shadow:0 4px 20px rgba(0,212,138,.35),0 1px 4px rgba(0,0,0,.2);
        transition:transform .15s,box-shadow .15s,opacity .15s;}
      .signin-btn:hover{
        transform:translateY(-1px);
        box-shadow:0 8px 30px rgba(0,212,138,.45),0 2px 8px rgba(0,0,0,.2);}

      .auth-foot{text-align:center;font-size:12px;color:var(--dim);margin-top:6px;}
      .auth-foot a{color:var(--accent);text-decoration:none;font-weight:500;}
      .auth-foot a:hover{text-decoration:underline;}

      @media(max-width:900px){
        .left{padding:40px 36px;max-width:100%;}
        .right{flex:0 0 100%;padding:24px;}
        .page{flex-direction:column;overflow-y:auto;height:auto;min-height:100vh;}
        .v-divider{display:none;}
      }
    </style>
  </head>
  <body class="auth-body">
    <div class="bg-grid"></div>
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>

    <button class="theme-btn" type="button" data-theme-toggle>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
      <span>Toggle theme</span>
    </button>

    <div id="toastContainer" class="toast-container"></div>
    <div id="globalLoader" class="loader-backdrop" style="display:none;">
      <div class="loader-spinner"></div>
    </div>

    <div class="page">
      <div class="left">
        <div class="brand-row">
          <div class="brand-badge">TB</div>
          <div>
            <div class="brand-name">TrackerBabu</div>
            <div class="brand-tag">Team Work Portal</div>
          </div>
        </div>

        <div class="brand-divider"></div>

        <div class="hero-tagline">Work Tracking Reimagined</div>

        <h1 class="hero-title">
          Daily work tracking<br />
          for <span>modern teams.</span>
        </h1>

        <p class="hero-desc">
          Capture what everyone shipped today, understand progress at a glance, and generate AI summaries for faster standups and status reports.
        </p>

        <div class="feature-list">
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            Task updates by member, project and status
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            Smart dashboards with weekly and monthly trends
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 0v10l4 4" /></svg>
            </div>
            AI-powered summaries for managers and stakeholders
          </div>
        </div>
      </div>

      <div class="v-divider"></div>

      <div class="right">
        <div class="auth-card">
          <div class="auth-title">Sign in</div>
          <div class="auth-sub">Access your TrackerBabu portal</div>

          <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
            <div class="flash-container">
              <% (successMessages || []).forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
              <% }) %>
              <% (errorMessages || []).forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
              <% }) %>
            </div>
          <% } %>

          <form method="post" action="/login" class="auth-form">
            <div class="field">
              <label for="email">Email</label>
              <div class="input-wrap">
                <input class="auth-inp has-icon" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
                <svg class="inp-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </div>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <div class="input-wrap">
                <input class="auth-inp has-icon" id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" />
                <svg class="inp-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
              </div>
            </div>

            <div class="forgot-link">
              <a href="/forgot-password">Forgot password?</a>
            </div>

            <button type="submit" class="signin-btn">Sign in</button>

            <div class="auth-foot">
              Don’t have an account?
              <a href="#" id="contactAdminLink">Contact your admin</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="/script.js"></script>
  </body>
</html>
