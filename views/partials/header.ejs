<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div id="globalLoader" class="loader-backdrop" style="display: none;">
      <div class="loader-spinner"></div>
    </div>
    <div class="ai-loader-backdrop" id="teamSummaryLoader">
      <div class="ai-loader-modal ai-task-card">
        <div class="ai-task-progress-block">
          <div class="ai-task-prog-top">
            <div class="ai-task-prog-left">
              <div class="ai-task-prog-phase" id="aiProgPhase">Phase 1 / 3 — Fetch</div>
              <div class="ai-task-prog-status" id="aiProgStatus">Fetching…</div>
            </div>
            <div class="ai-task-prog-right">
              <span class="ai-task-pct-num" id="aiPctNum">0</span>
              <div class="ai-task-pct-label">Complete</div>
            </div>
          </div>
          <div class="ai-task-bar-wrap" id="aiBarWrap"></div>
          <div class="ai-task-bar-meta">
            <div class="ai-task-bar-dots">
              <div class="ai-task-bar-dot-item"><div class="ai-task-dot ai-task-dot-a"></div>Fetch</div>
              <div class="ai-task-bar-dot-item"><div class="ai-task-dot ai-task-dot-b"></div>Read</div>
              <div class="ai-task-bar-dot-item"><div class="ai-task-dot ai-task-dot-c"></div>Generate</div>
            </div>
            <div class="ai-task-eta-label" id="aiEtaLbl">ETA —</div>
          </div>
        </div>
        <div class="ai-task-log-block">
          <div class="ai-task-log-line" id="aiLogLine">Initialising AI task summary engine…</div>
        </div>
        <div class="ai-task-footer">
          <div class="ai-task-stats">
            <div class="ai-task-stat">
              <div class="ai-task-stat-val" id="aiElapsedVal">0.0s</div>
              <div class="ai-task-stat-key">Elapsed</div>
            </div>
            <div class="ai-task-stat">
              <div class="ai-task-stat-val" id="aiTokensVal">0</div>
              <div class="ai-task-stat-key">Tokens</div>
            </div>
            <div class="ai-task-stat">
              <div class="ai-task-stat-val" id="aiStageVal">—</div>
              <div class="ai-task-stat-key">Stage</div>
            </div>
          </div>
          <button type="button" class="ai-task-btn-cancel" id="aiCancelBtn">Cancel</button>
        </div>
      </div>
    </div>
    <div class="ai-loader-backdrop" id="sheetSyncLoader">
      <div class="ai-loader-modal sheet-modal">
        <div class="modal-header sheets-header">
          <div class="header-left">
            <div class="sheets-icon-wrap">
              <svg viewBox="0 0 32 32" fill="none">
                <rect x="4" y="2" width="18" height="22" rx="2" fill="#0f9d58" />
                <path d="M18 2v6h6" fill="none" stroke="white" stroke-width="1.5" />
                <path d="M18 2l6 6H20a2 2 0 0 1-2-2V2z" fill="#087a43" />
                <rect x="7" y="12" width="12" height="1.4" rx="0.5" fill="white" opacity="0.9" />
                <rect x="7" y="15.5" width="12" height="1.4" rx="0.5" fill="white" opacity="0.9" />
                <rect x="7" y="19" width="8" height="1.4" rx="0.5" fill="white" opacity="0.9" />
              </svg>
            </div>
            <div class="header-text">
              <div class="modal-title">Syncing from Google Sheets</div>
              <div class="modal-subtitle" id="sheetPhase">Phase 1 / 3 — CONNECT</div>
            </div>
          </div>
          <div class="live-badge">
            <div class="live-dot"></div>Live Sync
          </div>
        </div>
        <div class="progress-section">
          <div class="progress-top">
            <div class="progress-label-group">
              <div class="progress-status" id="sheetStatus">Connecting to Google Sheets…</div>
            </div>
            <div class="pct-group">
              <span class="pct-big" id="sheetPctNum">0</span>
              <div class="pct-small">Complete</div>
            </div>
          </div>
          <div class="progress-bar-wrap">
            <div class="progress-bar-fill" id="sheetBarFill"></div>
          </div>
          <div class="bar-labels">
            <div class="bar-label-row">
              <div class="bar-label-item"><div class="bar-dot d1"></div>Connect</div>
              <div class="bar-label-item"><div class="bar-dot d2"></div>Read</div>
              <div class="bar-label-item"><div class="bar-dot d3"></div>Sync</div>
            </div>
            <div class="bar-label-item" id="sheetEta">ETA —</div>
          </div>
        </div>
        <div class="log-stream">
          <div class="log-line" id="sheetLogLine">Initialising extraction engine…</div>
        </div>
        <div class="modal-footer">
          <div class="footer-left">
            <div class="f-stat">
              <div class="f-stat-val" id="sheetElapsed">0.0s</div>
              <div class="f-stat-key">Elapsed</div>
            </div>
            <div class="f-stat">
              <div class="f-stat-val" id="sheetStage">—</div>
              <div class="f-stat-key">Stage</div>
            </div>
          </div>
          <button type="button" class="btn-cancel" id="sheetCancelBtn">Cancel</button>
        </div>
        <div class="done-overlay" id="sheetDoneOverlay">
          <div class="done-inner">
            <svg class="done-check" viewBox="0 0 24 24"><polyline points="5 13 10 18 19 7" /></svg>
          </div>
          <div class="done-title">Sync complete</div>
        </div>
      </div>
    </div>
    <div id="toastContainer" class="toast-container"></div>
    <div class="app-container">
      <%- include('sidebar') %>
      <main class="main-content">
        <header class="top-bar <%= (typeof topBarVariant !== 'undefined' && (topBarVariant === 'member' || topBarVariant === 'tasks')) ? 'top-bar-member' : '' %>">
          <div class="top-bar-left">
            <% if (typeof breadcrumb !== 'undefined' && breadcrumb && breadcrumb.length) { %>
              <h1 class="page-title pg-title-bc">
                <a href="<%= breadcrumb[0] === 'Members' ? '/members' : '#' %>" class="bc"><%= breadcrumb[0] %></a><span class="bc-sep">›</span><span class="bc-current"><%= breadcrumb[1] %></span>
              </h1>
            <% } else { %>
              <h1 class="page-title"><%= pageTitle || 'Dashboard' %></h1>
            <% } %>
          </div>
          <div class="top-bar-right">
            <button
              type="button"
              class="theme-btn header-theme-btn"
              data-theme-toggle
              aria-label="Toggle theme"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
              </svg>
              <span>Toggle theme</span>
            </button>
            <% if (typeof topBarVariant !== 'undefined' && topBarVariant === 'member' && typeof member !== 'undefined' && member) { %>
              <div class="dchip">Today — <b><%= todayFormatted || '' %></b></div>
              <% if (currentUser && currentUser.role === 'superadmin') { %>
                <form method="post" action="/members/<%= member.id %>/sync-sheet" class="top-bar-form-inline">
                  <button type="submit" class="btn btn-g">
                    <i class="fa-solid fa-arrows-rotate" style="font-size:11px;"></i> Sync Sheet
                  </button>
                </form>
                <a href="/summary/member/<%= member.id %>" class="btn btn-p">
                  <i class="fa-solid fa-wand-magic-sparkles" style="font-size:11px;"></i> Gemini AI Summary
                </a>
              <% } %>
            <% } else if (typeof topBarVariant !== 'undefined' && topBarVariant === 'tasks') { %>
              <div class="dchip">Today — <b><%= todayFormatted || '' %></b></div>
              <button type="button" class="btn btn-p" id="openAddTaskModal">
                <i class="fa-solid fa-plus" style="font-size:11px;"></i> Add Task
              </button>
            <% } else { %>
              <div class="dchip">Today — <b><%= todayFormatted || '' %></b></div>
            <% } %>
          </div>
        </header>

        <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
          <div class="flash-container">
            <% (successMessages || []).forEach(function(msg) { %>
              <div class="flash flash-success"><%= msg %></div>
            <% }) %>
            <% (errorMessages || []).forEach(function(msg) { %>
              <div class="flash flash-error"><%= msg %></div>
            <% }) %>
          </div>
        <% } %>

        <section class="content-inner">

