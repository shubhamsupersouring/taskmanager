<aside class="sidebar">
  <div class="sidebar-header">
    <div class="logo-circle">TB</div>
    <div class="logo-text">
      <span class="logo-title">TrackerBabu</span>
      <span class="logo-subtitle">Team Work Portal</span>
    </div>
    <button type="button" class="theme-toggle" data-theme-toggle>
      <span class="theme-toggle-track">
        <i class="fa-regular fa-sun theme-icon theme-icon-sun"></i>
        <i class="fa-regular fa-moon theme-icon theme-icon-moon"></i>
        <span class="theme-toggle-thumb"></span>
      </span>
    </button>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">
      Dashboard
    </a>
    <a href="/tasks" class="nav-link <%= currentPath.startsWith('/tasks') ? 'active' : '' %>">
      Tasks
    </a>
    <% if (currentUser && currentUser.role === 'superadmin') { %>
      <a href="/members" class="nav-link <%= currentPath.startsWith('/members') ? 'active' : '' %>">
        Members
      </a>
      <a href="/projects" class="nav-link <%= currentPath.startsWith('/projects') ? 'active' : '' %>">
        Projects
      </a>
      <a href="/summary/team" class="nav-link <%= currentPath.startsWith('/summary') ? 'active' : '' %>">
        Team Summary
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <% if (currentUser) { %>
      <div class="sidebar-user">
        <div class="user-initial">
          <%= currentUser.email.charAt(0).toUpperCase() %>
        </div>
        <div class="user-meta">
          <div class="user-email"><%= currentUser.email %></div>
          <div class="user-role"><%= currentUser.role === 'superadmin' ? 'Admin' : 'Member' %></div>
        </div>
      </div>
      <form method="post" action="/logout" class="sidebar-logout-form">
        <button type="submit" class="btn btn-outline btn-sm sidebar-logout-btn">Logout</button>
      </form>
    <% } %>
  </div>

  <button class="sidebar-toggle" id="sidebarToggle">
    ☰
  </button>
</aside>

