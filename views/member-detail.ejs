<%- include('partials/header') %>

  <section class="member-detail-layout">
    <div class="member-header card">
      <div class="card-header">
        <h2><%= member.name %></h2>
        <div>
          <% if (currentUser && currentUser.role === 'superadmin') { %>
            <form method="post" action="/members/<%= member.id %>/sync-sheet" style="display:inline;">
              <button type="submit" class="btn btn-outline btn-sm">Sync Sheet</button>
            </form>
            <a href="/summary/member/<%= member.id %>" class="btn btn-primary btn-sm">
              Gemini AI Summary
            </a>
          <% } %>
        </div>
      </div>
      <div class="card-body">
        <p class="text-muted">Role: <strong><%= member.role %></strong></p>
      </div>
    </div>

    <div class="member-stats-grid">
      <div class="card">
        <div class="card-header">
          <h3>Stats</h3>
        </div>
        <div class="card-body stats-pills">
          <div class="stat-pill-item">
            <span class="stat-label">Total tasks</span>
            <span class="stat-value"><%= totalTasks %></span>
          </div>
          <div class="stat-pill-item">
            <span class="stat-label">Done</span>
            <span class="stat-pill status-done"><%= statusCounts.done %></span>
          </div>
          <div class="stat-pill-item">
            <span class="stat-label">In progress</span>
            <span class="stat-pill status-in-progress"><%= statusCounts['in-progress'] %></span>
          </div>
          <div class="stat-pill-item">
            <span class="stat-label">Blocked</span>
            <span class="stat-pill status-blocked"><%= statusCounts.blocked %></span>
          </div>
          <div class="stat-pill-item">
            <span class="stat-label">Most productive week</span>
            <span class="stat-value"><%= mostProductiveWeekLabel %></span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3>Task History</h3>
        </div>
        <div class="card-body">
          <form
            method="get"
            action="/members/<%= member.id %>/export"
            class="filters-form"
            data-no-loader="true"
            style="margin-bottom: 0.75rem;"
          >
            <div class="form-group" style="flex: 1; min-width: 0;">
              <label for="exportStart">Export from</label>
              <input type="date" id="exportStart" name="start" required />
            </div>
            <div class="form-group" style="flex: 1; min-width: 0;">
              <label for="exportEnd">to</label>
              <input type="date" id="exportEnd" name="end" required />
            </div>
            <div class="filters-actions">
              <button type="submit" class="btn btn-primary btn-sm">
                Export Work
              </button>
            </div>
          </form>

          <form method="get" action="/members/<%= member.id %>" class="filters-form" style="margin-bottom: 0.75rem;">
            <div class="form-group">
              <label for="historyDate">Date</label>
              <input
                type="date"
                id="historyDate"
                name="date"
                value="<%= historyFilters && historyFilters.date ? historyFilters.date : '' %>"
              />
            </div>
            <div class="filters-actions">
              <button type="submit" class="btn btn-outline btn-sm">Apply</button>
              <a href="/members/<%= member.id %>" class="btn-link">Reset</a>
            </div>
          </form>

          <div class="table-wrapper">
            <table class="tasks-table" id="memberHistoryTable">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Task</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="memberHistoryBody">
                <% if (tasks.length) { %>
                  <% tasks.forEach(function(task) { %>
                    <tr>
                      <td><%= task.dateFormatted %></td>
                      <td><%= task.task %></td>
                      <td>
                        <span class="status-pill <%= 'status-' + task.status %>">
                          <%= task.status.replace('-', ' ') %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="empty-state">No tasks logged yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <div class="member-task-cards" id="memberHistoryCards">
            <% if (tasks.length) { %>
              <% tasks.forEach(function(task) { %>
                <div class="task-card">
                  <div class="task-card-header">
                    <div class="task-card-title"><%= task.task %></div>
                    <span class="status-pill <%= 'status-' + task.status %>">
                      <%= task.status.replace('-', ' ') %>
                    </span>
                  </div>
                  <div class="task-card-body">
                    <div class="task-card-meta">
                      <span class="task-meta-label">Date</span>
                      <span class="task-meta-value"><%= task.dateFormatted %></span>
                    </div>
                    <div class="task-card-meta">
                      <span class="task-meta-label">Status</span>
                      <span class="task-meta-value"><%= task.status.replace('-', ' ') %></span>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="empty-state">No tasks logged yet.</p>
            <% } %>
          </div>

          <% if (historyPagination && historyPagination.hasMore) { %>
            <p class="text-muted" id="memberHistoryLoading" style="margin-top: 0.5rem; font-size: 0.8rem;">
              Scroll to load more history…
            </p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="member-charts">
      <div class="card">
        <div class="card-header">
          <h3>Daily tasks (last 14 days)</h3>
        </div>
        <div class="card-body">
          <canvas id="dailyTasksChart"></canvas>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3>Monthly done tasks</h3>
        </div>
        <div class="card-body">
          <canvas id="monthlyDoneChart"></canvas>
        </div>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    (function () {
      var dailyData = <%- JSON.stringify(dailyChart || { labels: [], data: [] }) %>;
      var monthlyData = <%- JSON.stringify(monthlyChart || { labels: [], data: [] }) %>;

      var dailyCtx = document.getElementById('dailyTasksChart');
      if (dailyCtx && dailyData.labels.length) {
        new Chart(dailyCtx, {
          type: 'bar',
          data: {
            labels: dailyData.labels,
            datasets: [{
              label: 'Tasks',
              data: dailyData.data,
              backgroundColor: 'rgba(68, 114, 196, 0.7)'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              x: {
                ticks: { maxRotation: 90, minRotation: 45 }
              },
              y: {
                beginAtZero: true,
                precision: 0
              }
            }
          }
        });
      }

      var monthlyCtx = document.getElementById('monthlyDoneChart');
      if (monthlyCtx && monthlyData.labels.length) {
        new Chart(monthlyCtx, {
          type: 'line',
          data: {
            labels: monthlyData.labels,
            datasets: [{
              label: 'Done tasks',
              data: monthlyData.data,
              borderColor: 'rgba(112, 173, 71, 1)',
              backgroundColor: 'rgba(112, 173, 71, 0.2)',
              tension: 0.3,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                precision: 0
              }
            }
          }
        });
      }
    })();
  </script>

  <script>
    (function () {
      var pagination = <%- JSON.stringify(historyPagination || null) %>;
      if (!pagination) return;

      var page = pagination.page || 1;
      var hasMore = !!pagination.hasMore;
      var loading = false;

      var memberId = "<%= member.id %>";
      var currentDate = "<%= historyFilters && historyFilters.date ? historyFilters.date : '' %>";

      var tableBody = document.getElementById('memberHistoryBody');
      var cardsContainer = document.getElementById('memberHistoryCards');
      var loadingHint = document.getElementById('memberHistoryLoading');

      function appendTasks(tasks) {
        tasks.forEach(function (task) {
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + task.dateFormatted + '</td>' +
            '<td>' + task.task + '</td>' +
            '<td><span class="status-pill status-' + task.status + '">' +
            task.status.replace('-', ' ') +
            '</span></td>';
          if (tableBody) tableBody.appendChild(tr);

          if (cardsContainer) {
            var card = document.createElement('div');
            card.className = 'task-card';
            card.innerHTML =
              '<div class="task-card-header">' +
              '  <div class="task-card-title">' + task.task + '</div>' +
              '  <span class="status-pill status-' + task.status + '">' +
              task.status.replace('-', ' ') +
              '</span>' +
              '</div>' +
              '<div class="task-card-body">' +
              '  <div class="task-card-meta">' +
              '    <span class="task-meta-label">Date</span>' +
              '    <span class="task-meta-value">' + task.dateFormatted + '</span>' +
              '  </div>' +
              '  <div class="task-card-meta">' +
              '    <span class="task-meta-label">Status</span>' +
              '    <span class="task-meta-value">' + task.status.replace('-', ' ') + '</span>' +
              '  </div>' +
              '</div>';
            cardsContainer.appendChild(card);
          }
        });
      }

      function loadMore() {
        if (loading || !hasMore) return;
        loading = true;

        var qs = 'page=' + (page + 1);
        if (currentDate) qs += '&date=' + encodeURIComponent(currentDate);

        if (window.showLoader) window.showLoader();
        fetch('/members/' + memberId + '/page?' + qs)
          .then(function (res) {
            if (!res.ok) throw new Error('Failed');
            return res.json();
          })
          .then(function (data) {
            if (!data.success) return;
            page += 1;
            hasMore = data.hasMore;
            appendTasks(data.tasks);
            if (!hasMore && loadingHint) {
              loadingHint.textContent = 'No more history.';
            }
          })
          .catch(function () {
            // silent
          })
          .finally(function () {
            loading = false;
            if (window.hideLoader) window.hideLoader();
          });
      }

      window.addEventListener('scroll', function () {
        if (!hasMore || loading) return;
        var scrollPosition = window.innerHeight + window.scrollY;
        var threshold = document.body.offsetHeight - 200;
        if (scrollPosition >= threshold) {
          loadMore();
        }
      });
    })();
  </script>

  <script src="/script.js"></script>
      </section>
    </div>
  </body>
</html>

