<%- include('partials/header') %>

  <section class="content content-member-detail member-detail-layout">
    <!-- HERO -->
    <div class="md-hero hero">
      <div class="hav">
        <%= (member.name || '?').split(' ').map(function(p){ return p[0]; }).join('').slice(0,2).toUpperCase() %>
        <div class="sring"></div>
      </div>
      <div class="hinfo">
        <div class="hname"><%= member.name %></div>
        <div class="hmeta">
          <div class="hrole">Role: <b><%= member.role %></b></div>
          <% if (member.email) { %><div class="hdot"></div><div class="hemail"><%= member.email %></div><% } %>
          <div class="hdot"></div>
          <div class="pill <%= (typeof todayTaskCount !== 'undefined' && todayTaskCount > 0) ? 'pill-on' : 'pill-off' %>"><%= (typeof todayTaskCount !== 'undefined' && todayTaskCount > 0) ? '● Active' : 'Idle' %></div>
        </div>
      </div>
      <div class="hacts">
        <% if (currentUser && currentUser.role === 'superadmin') { %>
          <a href="/members" class="btn btn-g"><i class="fa-solid fa-pen" style="font-size:11px;"></i> Edit</a>
        <% } %>
        <% if (currentUser && (currentUser.role === 'superadmin' || (currentUser.member_id && String(currentUser.member_id) === String(member.id)))) { %>
          <form method="post" action="/members/<%= member.id %>/sync-sheet" class="top-bar-form-inline">
            <button type="submit" class="btn btn-g">
              <i class="fa-solid fa-arrows-rotate" style="font-size:11px;"></i> Sync Sheet
            </button>
          </form>
        <% } %>
        <a href="/tasks?member_id=<%= member.id %>&date=<%= new Date().toISOString().slice(0,10) %>" class="btn btn-p"><i class="fa-solid fa-plus" style="font-size:11px;"></i> Add Task</a>
      </div>
    </div>

    <!-- MAIN GRID -->
    <div class="grid2">
      <!-- STATS -->
      <div class="md-card card">
        <div class="ctitle">Stats</div>
        <div class="srow"><div class="slbl">Total tasks</div><div class="sval"><%= totalTasks %></div></div>
        <div class="srow"><div class="slbl">Done</div><div class="sbadge bdn"><%= statusCounts.done %></div></div>
        <div class="srow"><div class="slbl">In progress</div><div class="sbadge bip"><%= statusCounts['in-progress'] %></div></div>
        <div class="srow"><div class="slbl">Blocked</div><div class="sbadge bbl"><%= statusCounts.blocked %></div></div>
        <div class="srow"><div class="slbl">Most productive week</div><div class="sna"><%= mostProductiveWeekLabel %></div></div>
      </div>

      <!-- TASK HISTORY -->
      <div class="md-card card">
        <div class="th-head">
          <div class="ctitle" style="margin-bottom:0">Task History</div>
          <form method="get" action="/members/<%= member.id %>/export" class="export-form-inline" data-no-loader="true">
            <input type="date" name="start" id="exportStart" class="inp inp-sm" required />
            <input type="date" name="end" id="exportEnd" class="inp inp-sm" required />
            <button type="submit" class="export-btn">
              <i class="fa-solid fa-download" style="font-size:11px;"></i> Export Work
            </button>
          </form>
        </div>

        <div class="th-filters">
          <form method="get" action="/members/<%= member.id %>" class="th-row">
            <div class="th-field">
              <label>Filter by Date</label>
              <input type="date" class="inp" name="date" value="<%= historyFilters && historyFilters.date ? historyFilters.date : '' %>" id="dateFilter" />
            </div>
            <div class="th-actions">
              <button type="submit" class="apply-btn">Apply</button>
              <a href="/members/<%= member.id %>" class="reset-btn">Reset</a>
            </div>
          </form>
        </div>

        <div id="historyResult" class="history-result">
          <% if (tasks.length) { %>
            <table class="ttable">
              <thead><tr><th>Date</th><th>Task</th><th>Status</th></tr></thead>
              <tbody id="memberHistoryBody">
                <% tasks.forEach(function(task) { %>
                  <tr>
                    <td><%= task.dateFormatted %></td>
                    <td><%= task.task %></td>
                    <td><span class="tstatus ts-<%= task.status === 'done' ? 'dn' : task.status === 'in-progress' ? 'ip' : 'bl' %>"><span class="tsdot"></span><%= task.status === 'done' ? 'Done' : task.status === 'in-progress' ? 'In Progress' : 'Blocked' %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <% if (historyPagination && historyPagination.hasMore) { %>
              <p class="load-more-hint" id="memberHistoryLoading">Scroll to load more…</p>
            <% } %>
          <% } else { %>
            <div class="empty">
              <div class="ei"><i class="fa-regular fa-calendar" style="font-size:18px;"></i></div>
              <div class="et">No tasks logged yet</div>
              <div class="es">Tasks will appear here once logged</div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- DAILY CHART -->
      <div class="md-card card">
        <div class="ctitle">Daily tasks <span class="ctitle-note">(last 14 days)</span></div>
        <div class="chart-wrap-md">
          <canvas id="dailyTasksChart"></canvas>
        </div>
      </div>

      <!-- MONTHLY CHART -->
      <div class="md-card card">
        <div class="ctitle">Monthly done tasks <span class="ctitle-note">(<%= typeof monthYearLabel !== 'undefined' ? monthYearLabel : '' %>)</span></div>
        <div class="chart-wrap-md">
          <canvas id="monthlyDoneChart"></canvas>
        </div>
      </div>

      <!-- RECENT TASKS (full width) -->
      <div class="md-card card span2">
        <div class="rt-head">
          <div class="ctitle" style="margin-bottom:0">Recent Tasks</div>
          <div class="rt-actions">
            <a href="/tasks?member_id=<%= member.id %>" class="btn btn-g btn-sm"><i class="fa-solid fa-filter" style="font-size:10px;"></i> Filter</a>
          </div>
        </div>

        <% if (tasks.length) { %>
          <table class="ttable">
            <thead><tr><th>Task</th><th>Status</th><th>Date</th></tr></thead>
            <tbody>
              <% tasks.slice(0, 10).forEach(function(task) { %>
                <tr>
                  <td><%= task.task %></td>
                  <td><span class="tstatus ts-<%= task.status === 'done' ? 'dn' : task.status === 'in-progress' ? 'ip' : 'bl' %>"><span class="tsdot"></span><%= task.status === 'done' ? 'Done' : task.status === 'in-progress' ? 'In Progress' : 'Blocked' %></span></td>
                  <td style="color:var(--dim2)"><%= task.dateFormatted %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty empty-lg">
            <div class="ei"><i class="fa-regular fa-square-plus" style="font-size:22px;"></i></div>
            <div class="et">No tasks assigned yet</div>
            <div class="es">Once tasks are assigned to <%= member.name %>, they'll appear here</div>
            <a href="/tasks?member_id=<%= member.id %>&date=<%= new Date().toISOString().slice(0,10) %>" class="btn btn-p" style="margin-top:10px;"><i class="fa-solid fa-plus" style="font-size:11px;"></i> Assign First Task</a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    (function () {
      var dailyData = <%- JSON.stringify(dailyChart || { labels: [], data: [] }) %>;
      var monthlyData = <%- JSON.stringify(monthlyChart || { labels: [], data: [] }) %>;
      var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#00d48a';

      var dailyCtx = document.getElementById('dailyTasksChart');
      if (dailyCtx && dailyData.labels.length) {
        new Chart(dailyCtx, {
          type: 'bar',
          data: {
            labels: dailyData.labels,
            datasets: [{ label: 'Tasks', data: dailyData.data, backgroundColor: accent + '99' }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { x: { ticks: { maxRotation: 45, font: { size: 10 } } }, y: { beginAtZero: true, precision: 0 } }
          }
        });
      }

      var monthlyCtx = document.getElementById('monthlyDoneChart');
      if (monthlyCtx && monthlyData.labels.length) {
        new Chart(monthlyCtx, {
          type: 'line',
          data: {
            labels: monthlyData.labels,
            datasets: [{
              label: 'Done',
              data: monthlyData.data,
              borderColor: accent,
              backgroundColor: accent + '33',
              tension: 0.3,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, precision: 0 } }
          }
        });
      }
    })();
  </script>

  <script>
    (function () {
      var pagination = <%- JSON.stringify(historyPagination || null) %>;
      if (!pagination) return;
      var page = pagination.page || 1;
      var hasMore = !!pagination.hasMore;
      var loading = false;
      var memberId = "<%= member.id %>";
      var currentDate = "<%= (historyFilters && historyFilters.date) ? historyFilters.date : '' %>";
      var tableBody = document.getElementById('memberHistoryBody');
      var loadingHint = document.getElementById('memberHistoryLoading');

      function appendTasks(tasks) {
        if (!tableBody) return;
        tasks.forEach(function (task) {
          var statusClass = task.status === 'done' ? 'dn' : task.status === 'in-progress' ? 'ip' : 'bl';
          var statusLabel = task.status === 'done' ? 'Done' : task.status === 'in-progress' ? 'In Progress' : 'Blocked';
          var tr = document.createElement('tr');
          tr.innerHTML = '<td>' + task.dateFormatted + '</td><td>' + task.task + '</td><td><span class="tstatus ts-' + statusClass + '"><span class="tsdot"></span>' + statusLabel + '</span></td>';
          tableBody.appendChild(tr);
        });
      }

      function loadMore() {
        if (loading || !hasMore) return;
        loading = true;
        var qs = 'page=' + (page + 1);
        if (currentDate) qs += '&date=' + encodeURIComponent(currentDate);
        if (window.showLoader) window.showLoader();
        fetch('/members/' + memberId + '/page?' + qs)
          .then(function (res) { return res.ok ? res.json() : Promise.reject(); })
          .then(function (data) {
            if (!data.success) return;
            page += 1;
            hasMore = data.hasMore;
            appendTasks(data.tasks);
            if (!hasMore && loadingHint) loadingHint.textContent = 'No more history.';
          })
          .catch(function () {})
          .finally(function () {
            loading = false;
            if (window.hideLoader) window.hideLoader();
          });
      }

      window.addEventListener('scroll', function () {
        if (!hasMore || loading) return;
        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) loadMore();
      });
    })();
  </script>
  <script src="/script.js"></script>
  </section>
    </div>
  </body>
</html>
