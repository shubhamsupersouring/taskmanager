<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu — Set new password' %></title>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="auth-body">
    <div class="bg-grid"></div>
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>

    <button class="theme-btn" type="button" data-theme-toggle>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
      <span>Toggle theme</span>
    </button>

    <div id="toastContainer" class="toast-container"></div>
    <div id="globalLoader" class="loader-backdrop" style="display:none;">
      <div class="loader-spinner"></div>
    </div>

    <div class="page">
      <div class="left">
        <div class="brand-row">
          <div class="brand-badge">TB</div>
          <div>
            <div class="brand-name">TrackerBabu</div>
            <div class="brand-tag">Team Work Portal</div>
          </div>
        </div>

        <div class="brand-divider"></div>

        <div class="hero-tagline">Security First</div>

        <h1 class="hero-title">
          Choose a fresh,<br />
          <span>secure password.</span>
        </h1>

        <p class="hero-desc">
          You’re one step away from getting back to your daily work tracking. Set a strong password to keep your team’s updates and AI summaries safe.
        </p>

        <div class="feature-list">
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            Use at least 6–8 characters with numbers and symbols
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            Avoid reusing passwords from other tools
          </div>
          <div class="feat">
            <div class="feat-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 0v10l4 4" /></svg>
            </div>
            You can always reset again if you forget it
          </div>
        </div>
      </div>

      <div class="v-divider"></div>

      <div class="right">
        <div class="auth-card">
          <div class="auth-title">Set new password</div>
          <div class="auth-sub">Choose a new password for your account.</div>

          <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
            <div class="flash-container">
              <% (successMessages || []).forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
              <% }) %>
              <% (errorMessages || []).forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
              <% }) %>
            </div>
          <% } %>

          <form method="post" action="/reset-password" class="auth-form">
            <input type="hidden" name="token" value="<%= token %>" />

            <div class="field">
              <label for="password">New password</label>
              <div class="input-wrap">
                <input
                  class="auth-inp has-icon"
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="6"
                  placeholder="Create a strong password"
                />
                <svg class="inp-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
              </div>
            </div>

            <div class="field">
              <label for="confirmPassword">Confirm password</label>
              <div class="input-wrap">
                <input
                  class="auth-inp has-icon"
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  required
                  minlength="6"
                  placeholder="Re-enter the new password"
                />
                <svg class="inp-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
              </div>
            </div>

            <button type="submit" class="signin-btn">Update password</button>

            <div class="auth-foot">
              Remember your password? <a href="/login">Back to login</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="/script.js"></script>
  </body>
</html>
