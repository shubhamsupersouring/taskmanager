<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle ? pageTitle + ' | TrackerBabu' : 'TrackerBabu' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="login-body">
    <div id="toastContainer" class="toast-container"></div>
    <div id="globalLoader" class="loader-backdrop" style="display: none;">
      <div class="loader-spinner"></div>
    </div>
    <div class="login-wrapper">
      <div class="login-left">
        <div class="login-badge">
          <span>TrackerBabu</span>
        </div>
        <h1 class="login-headline">Choose a fresh, secure password.</h1>
        <p class="login-copy">
          You’re just one step away from getting back to your daily work tracking.
          Set a strong password to keep your team’s updates and AI summaries safe.
        </p>
        <ul class="login-bullets">
          <li>Use at least 6–8 characters with numbers and symbols.</li>
          <li>Avoid reusing passwords from other tools.</li>
          <li>You can always reset again if you forget it.</li>
        </ul>
      </div>
      <div class="login-card">
        <div class="login-mobile-hero">
          <div class="login-badge">
            <span>TrackerBabu</span>
          </div>
          <h2 class="login-mobile-headline">Set a new TrackerBabu password.</h2>
        </div>
        <h1 class="login-title">Set new password</h1>
        <p class="login-subtitle">
          Choose a new password for your account.
        </p>

        <% if ((successMessages && successMessages.length) || (errorMessages && errorMessages.length)) { %>
          <div class="flash-container">
            <% (successMessages || []).forEach(function(msg) { %>
              <div class="flash flash-success"><%= msg %></div>
            <% }) %>
            <% (errorMessages || []).forEach(function(msg) { %>
              <div class="flash flash-error"><%= msg %></div>
            <% }) %>
          </div>
        <% } %>

        <form method="post" action="/reset-password" class="login-form">
          <input type="hidden" name="token" value="<%= token %>" />

          <div class="form-group">
            <label for="password">New password</label>
            <div class="password-field">
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength="6"
              />
              <button
                type="button"
                class="password-toggle"
                aria-label="Show password"
                data-target="password"
              >
                👁
              </button>
            </div>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm password</label>
            <div class="password-field">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                required
                minlength="6"
              />
              <button
                type="button"
                class="password-toggle"
                aria-label="Show password"
                data-target="confirmPassword"
              >
                👁
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary login-submit">
            Update password
          </button>
        </form>

        <div class="login-hint">
          <p>
            <a href="/login" class="btn-link">Back to login</a>
          </p>
        </div>
      </div>
    </div>
    <script src="/script.js"></script>
  </body>
</html>

