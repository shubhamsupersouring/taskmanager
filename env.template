# ============================================
# Muskaan Dreams Node.js API - Environment Configuration
# ============================================
# Database configuration comes from appsettings.json files (NOT from here)
# This file is only for environment selection and optional overrides
# ============================================

# ============================================
# Environment Selection
# ============================================
# Set to: development, staging, or production
# This determines which appsettings.{Environment}.json file to load
ENVIRONMENT=development

# Alternative: You can also use NODE_ENV
# NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
PORT=3001

# ============================================
# JWT Configuration (Optional Override)
# ============================================
# These can override values from appsettings.json if needed
# Get from Azure Key Vault: adminportal-jwt-secretkey and adminportal-jwt-issuer
# JWT_SECRET=your-jwt-secret-from-net-service
# JWT_ISSUER=muskaandreams
JWT_EXPIRES_IN=7d

# Alternative: Use same Key Vault key names as .NET project
# adminportal-jwt-secretkey=your-jwt-secret-from-net-service
# adminportal-jwt-issuer=muskaandreams

# ============================================
# Password Hashing
# ============================================
BCRYPT_SALT_ROUNDS=10

# ============================================
# Application
# ============================================
APP_NAME=Muskaan Dreams Node.js API
APP_URL=http://localhost:3001

# ============================================
# Azure Key Vault (Optional - for future use)
# ============================================
# USE_AZURE_KEYVAULT=false
# KEYVAULT_NAME=kv-muskaandreams-dev

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Database configuration is in appsettings.{Environment}.json files
# 2. Set ENVIRONMENT variable to switch between: development, staging, production
# 3. Database connection strings are configured in:
#    - appsettings.Development.json (for development)
#    - appsettings.Staging.json (for staging)
#    - appsettings.Production.json (for production)
# 4. This .env file is only for environment selection and optional overrides
